public class SquareCalculator {

    // Returns square of an integer with addition of two numbers.
    public static Integer square(Integer anusenumber) {
        if (anuusenum == null) {
            return 0;
            //this will return an positive
        }
        //this will return an addition
        return anuusenum * anuusenum;
        
      
    }
}
